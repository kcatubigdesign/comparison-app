---
import { getAvatarColor, sortByApyDesc, trendDirection } from "../lib/data";
import type { ProductSnapshot } from "../lib/types";

interface Props {
  items: ProductSnapshot[];
  limit?: number;
}

const { items, limit = 6 } = Astro.props;
const ranked = sortByApyDesc(items).slice(0, limit);

function sparklinePoints(trend: number[]): string {
  if (trend.length < 2) return "";
  const min = Math.min(...trend);
  const max = Math.max(...trend);
  const range = max - min || 1;
  const stepX = 80 / (trend.length - 1);
  return trend
    .map((value, i) => {
      const x = i * stepX;
      const y = 20 - ((value - min) / range) * 18 - 1;
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(" ");
}
---

<div class="rounded-2xl border border-border-subtle bg-panel">
  <div class="flex items-center justify-between border-b border-border-subtle px-5 py-4">
    <h2 class="text-lg font-bold text-ink">Savings Leaderboard</h2>
    <span class="rounded-md bg-border-subtle px-3 py-1 text-xs font-semibold text-ink-muted">
      Top {ranked.length} Rated
    </span>
  </div>
  <ul>
    {
      ranked.map((item, index) => {
        const direction = trendDirection(item.recentApyTrend);
        const isUp = direction !== "down";
        return (
          <li class="flex flex-wrap items-center gap-4 border-b border-border-subtle px-5 py-4 last:border-b-0 sm:flex-nowrap sm:gap-6">
            <span
              class={`flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-semibold ${
                index === 0 ? "bg-ink text-white" : "bg-border-subtle text-ink-muted"
              }`}
            >
              {index + 1}
            </span>
            <span
              class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white"
              style={`background-color:${getAvatarColor(item.bankId)}`}
            >
              {item.bankName.charAt(0)}
            </span>
            <div class="min-w-[140px] flex-1 sm:flex-none sm:w-56">
              <p class="text-sm font-semibold text-ink">{item.bankName}</p>
              <p class="text-xs text-ink-muted">{item.productName}</p>
            </div>
            <svg
              class="hidden shrink-0 sm:block"
              width="80"
              height="20"
              viewBox="0 0 80 20"
              fill="none"
            >
              <polyline
                points={sparklinePoints(item.recentApyTrend)}
                stroke={isUp ? "#059669" : "#2563eb"}
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <div class="ml-auto flex items-center gap-2 sm:ml-auto">
              <span class="text-base font-bold text-ink">{item.apy.toFixed(2)}% APY</span>
              <span class={isUp ? "text-positive" : "text-negative"}>
                {isUp ? "↗" : "↘"}
              </span>
            </div>
          </li>
        );
      })
    }
  </ul>
</div>
