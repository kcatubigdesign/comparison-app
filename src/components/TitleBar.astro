---
import { formatLastChecked } from "../lib/data";

interface Props {
  lastCheckedAt: string;
}

const { lastCheckedAt } = Astro.props;
---

<div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
  <div class="flex flex-col gap-1">
    <h1 class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
      Compare Savings Rates
    </h1>
    <p class="max-w-xl text-sm text-ink-muted">
      We bring publicly available savings account rates and offers from multiple
      banks together in one place, so you can compare them side by side.
    </p>
  </div>
  <div class="flex items-center gap-2 text-sm text-ink-muted">
    <span class="h-2 w-2 shrink-0 rounded-full bg-positive"></span>
    <span>Rates updated {formatLastChecked(lastCheckedAt)}</span>
  </div>
</div>
